# zsh-syntax-highlighting baseline — theme-independent flags.
# The semantic block below sets ZSH_HIGHLIGHT_STYLES[<scope>] entries.

# Which highlighter families are active (theme-independent).
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Ensure the array exists so the semantic block's assignments succeed
# even before syntax-highlighting has been sourced.
typeset -gA ZSH_HIGHLIGHT_STYLES
