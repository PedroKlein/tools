# btop baseline — theme-independent settings.
# The semantic block below overwrites this file entirely with the
# theme[<key>]="#hex" entries expected by btop.

# Default values here are conservative fallbacks for a bare-minimum
# theme (used only when the semantic block is skipped in a test).
theme[main_bg]=""
theme[main_fg]="#cccccc"
theme[title]="#eeeeee"
theme[hi_fg]="#ffffff"
theme[selected_bg]="#333333"
theme[selected_fg]="#eeeeee"
