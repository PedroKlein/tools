# ghostty baseline — theme-independent config.
# The semantic block below appends `background`, `foreground`,
# `cursor-color`, `background-opacity`, `background-blur`, and the 16
# `palette = N=#hex` entries.
#
# Anything set here is a safe default that survives when a theme omits
# corresponding hints/overrides.

# Cursor style unless the theme's effects.cursor override wins.
cursor-style = block

# Copy-on-select is expected on macOS; theme-independent behavior.
copy-on-select = clipboard
