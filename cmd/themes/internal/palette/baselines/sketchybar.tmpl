#!/usr/bin/env bash
# sketchybar baseline — theme-independent bar geometry.
# The semantic block below exports color vars (BAR_BG, FG, ACCENT, ...)
# consumed by the sketchybarrc plugin scripts.

# Bar geometry defaults; overridable via hints.sketchybar.{barHeight,cornerRadius}.
export BAR_HEIGHT=25
export BAR_CORNER_RADIUS=0
export BAR_MARGIN=0
export BAR_Y_OFFSET=0

# Font defaults; overridable via typography hints.
export BAR_FONT="MonaspiceNe Nerd Font"
export BAR_ICON_FONT="MonaspiceNe Nerd Font"
