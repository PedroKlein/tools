# ghostty baseline — theme-independent config.
# The semantic block below appends `background`, `foreground`,
# `cursor-color`, `background-opacity` (per theme; if effects.opacity in
# (0,1)), `background-blur` (per theme; if effects.blur > 0), and the 16
# `palette = N=#hex` entries.
#
# Per arrangement A of docs/plans/theme-transparency.md, per-theme
# opacity/blur here overrides the fallbacks in ~/.config/ghostty/config
# via Ghostty's `config-file` chain semantics.
#
# background-opacity-cells is NOT emitted per theme — that's a global
# policy set once in the user's ghostty config so every theme inherits
# the same cell-opacity behavior.
#
# Anything set here is a safe default that survives when a theme omits
# corresponding hints/overrides.

# Cursor style unless the theme's effects.cursor override wins.
cursor-style = block

# Copy-on-select is expected on macOS; theme-independent behavior.
copy-on-select = clipboard
